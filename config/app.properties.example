# ==============================================================================
# POS_app - File-based Application Configuration Template (Java I/O)
# ==============================================================================
# Salin file ini menjadi 'config/app.properties' dan sesuaikan pengaturan direktori jika diperlukan.
# ==============================================================================

# Directory path where CSV data files are stored
app.data.dir=data

# Application info
app.name=POS_app
app.version=1.0.0
app.env=development

# Currency & locale
app.currency.symbol=Rp
app.timezone=Asia/Jakarta
