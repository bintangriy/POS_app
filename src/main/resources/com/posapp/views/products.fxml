<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.posapp.controller.ProductController"
      spacing="14" stylesheets="@../styles/main.css">

    <!-- Header & Controls -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card">
        <TextField fx:id="txtSearch" promptText="Cari nama atau barcode..." onKeyReleased="#handleSearch" prefWidth="250"/>
        <ComboBox fx:id="cmbCategory" onAction="#handleCategoryFilter" prefWidth="200"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Tambah Produk" onAction="#handleAddProduct" styleClass="btn-primary"/>
        <Button text="✏️ Edit" onAction="#handleEditProduct" styleClass="btn-secondary"/>
        <Button text="🗑 Hapus" onAction="#handleDeleteProduct" styleClass="btn-danger"/>
    </HBox>

    <!-- Products Table -->
    <TableView fx:id="tblProducts" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colBarcode" text="Barcode" prefWidth="130"/>
            <TableColumn fx:id="colName" text="Nama Produk" prefWidth="260"/>
            <TableColumn fx:id="colCategory" text="Kategori" prefWidth="160"/>
            <TableColumn fx:id="colBuyPrice" text="Harga Modal (HPP)" prefWidth="130"/>
            <TableColumn fx:id="colSellPrice" text="Harga Jual" prefWidth="130"/>
            <TableColumn fx:id="colStock" text="Stok Fisik" prefWidth="90"/>
            <TableColumn fx:id="colMinStock" text="Min Alert" prefWidth="90"/>
        </columns>
    </TableView>

    <Label fx:id="lblMessage" text="" style="-fx-text-fill: #16A34A; -fx-font-weight: bold;"/>

</VBox>

