<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.posapp.controller.ReportController"
      spacing="14" stylesheets="@../styles/main.css">

    <Label text="Laporan Keuangan &amp; Analitik Penjualan Toko" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- Tab 1: Laporan Penjualan Harian -->
        <Tab text="📅 Penjualan Harian">
            <VBox spacing="14" styleClass="card">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Pilih Tanggal:" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpReportDate"/>
                    <Button text="Muat Laporan" onAction="#handleLoadDailyReport" styleClass="btn-primary"/>
                </HBox>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="0">
                        <Label text="TOTAL TRANSAKSI" styleClass="metric-title"/>
                        <Label fx:id="lblDailyCount" text="0 Transaksi" styleClass="metric-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="1">
                        <Label text="TOTAL OMSET (REVENUE)" styleClass="metric-title"/>
                        <Label fx:id="lblDailyOmset" text="Rp 0" styleClass="metric-value-highlight"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="2">
                        <Label text="TOTAL MODAL (HPP)" styleClass="metric-title"/>
                        <Label fx:id="lblDailyHpp" text="Rp 0" styleClass="metric-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="3">
                        <Label text="LABA KOTOR (PROFIT)" styleClass="metric-title"/>
                        <Label fx:id="lblDailyProfit" text="Rp 0" styleClass="metric-value" style="-fx-text-fill: #16A34A;"/>
                    </VBox>
                </GridPane>
            </VBox>
        </Tab>

        <!-- Tab 2: Laporan Penjualan Bulanan -->
        <Tab text="📆 Penjualan Bulanan">
            <VBox spacing="14" styleClass="card">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Tahun:"/>
                    <ComboBox fx:id="cmbYear" prefWidth="100"/>
                    <Label text="Bulan:"/>
                    <ComboBox fx:id="cmbMonth" prefWidth="160"/>
                    <Button text="Muat Laporan Bulanan" onAction="#handleLoadMonthlyReport" styleClass="btn-primary"/>
                </HBox>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="0">
                        <Label text="TOTAL TRANSAKSI" styleClass="metric-title"/>
                        <Label fx:id="lblMonthlyCount" text="0 Transaksi" styleClass="metric-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="1">
                        <Label text="OMSET BULAN INI" styleClass="metric-title"/>
                        <Label fx:id="lblMonthlyOmset" text="Rp 0" styleClass="metric-value-highlight"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="2">
                        <Label text="HPP MODAL BARANG" styleClass="metric-title"/>
                        <Label fx:id="lblMonthlyHpp" text="Rp 0" styleClass="metric-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="3">
                        <Label text="LABA KOTOR BULANAN" styleClass="metric-title"/>
                        <Label fx:id="lblMonthlyProfit" text="Rp 0" styleClass="metric-value" style="-fx-text-fill: #16A34A;"/>
                    </VBox>
                </GridPane>
            </VBox>
        </Tab>

        <!-- Tab 3: Produk Terlaris -->
        <Tab text="🏆 Produk Terlaris">
            <VBox spacing="10" styleClass="card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Daftar 10 Produk dengan Volume Penjualan Tertinggi" style="-fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Segarkan" onAction="#handleLoadTopSelling" styleClass="btn-secondary"/>
                </HBox>
                <TableView fx:id="tblTopSelling" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTopProduct" text="Nama Produk" prefWidth="350"/>
                        <TableColumn fx:id="colTopQty" text="Total Terjual (Unit)" prefWidth="180"/>
                        <TableColumn fx:id="colTopRevenue" text="Total Omset Produk" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 4: Valuasi Persediaan Toko -->
        <Tab text="📦 Valuasi Aset Persediaan">
            <VBox spacing="14" styleClass="card">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="Ringkasan Nilai Aset Stok Barang di Toko Saat Ini" style="-fx-font-weight: bold;"/>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                    </columnConstraints>

                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="0">
                        <Label text="TOTAL VARIASI (SKU)" styleClass="metric-title"/>
                        <Label fx:id="lblValuationSku" text="0 SKU" styleClass="metric-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="1">
                        <Label text="TOTAL FISIK BARANG" styleClass="metric-title"/>
                        <Label fx:id="lblValuationUnits" text="0 Unit" styleClass="metric-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="card" GridPane.columnIndex="2">
                        <Label text="TOTAL VALUASI ASET (HPP)" styleClass="metric-title"/>
                        <Label fx:id="lblValuationTotal" text="Rp 0" styleClass="metric-value-highlight"/>
                    </VBox>
                </GridPane>
            </VBox>
        </Tab>

    </TabPane>

</VBox>

