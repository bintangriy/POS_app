<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.posapp.controller.TransactionHistoryController"
      spacing="14" stylesheets="@../styles/main.css">

    <!-- Filters Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card">
        <Label text="Dari Tanggal:"/>
        <DatePicker fx:id="dpFrom"/>
        <Label text="Sampai:"/>
        <DatePicker fx:id="dpTo"/>
        <TextField fx:id="txtSearchInvoice" promptText="Cari No. Faktur..." prefWidth="180"/>
        <Button text="Filter" onAction="#handleFilter" styleClass="btn-primary"/>
        <Button text="Reset" onAction="#handleReset" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🖨 Cetak Ulang Nota" onAction="#handleReprintReceipt" styleClass="btn-secondary"/>
        <Button fx:id="btnCancelTransaction" text="🚫 Batalkan Transaksi" onAction="#handleCancelTransaction" styleClass="btn-danger"/>
    </HBox>

    <Label fx:id="lblMessage" text="" style="-fx-font-weight: bold; -fx-text-fill: #2563EB;"/>

    <!-- Split: Transactions Table on Top, Details Table Below -->
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <VBox spacing="6">
            <Label text="Daftar Nota Transaksi Penjualan:" style="-fx-font-weight: bold;"/>
            <TableView fx:id="tblTransactions" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colInvoice" text="No. Faktur" prefWidth="170"/>
                    <TableColumn fx:id="colDate" text="Tanggal Transaksi" prefWidth="140"/>
                    <TableColumn fx:id="colCashier" text="Kasir" prefWidth="160"/>
                    <TableColumn fx:id="colPayment" text="Metode Bayar" prefWidth="110"/>
                    <TableColumn fx:id="colTotal" text="Grand Total" prefWidth="130"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="6">
            <Label text="Rincian Barang Belanjaan pada Nota Terpilih:" style="-fx-font-weight: bold;"/>
            <TableView fx:id="tblDetails" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colItemProduct" text="Nama Produk" prefWidth="280"/>
                    <TableColumn fx:id="colItemPrice" text="Harga Satuan (Snapshot)" prefWidth="160"/>
                    <TableColumn fx:id="colItemQty" text="Kuantitas" prefWidth="100"/>
                    <TableColumn fx:id="colItemTotal" text="Subtotal Item" prefWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </SplitPane>

</VBox>

