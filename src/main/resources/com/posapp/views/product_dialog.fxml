<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.posapp.controller.ProductDialogController"
      spacing="14" prefWidth="420" stylesheets="@../styles/main.css" styleClass="card">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Informasi Master Produk" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <VBox spacing="4">
        <Label text="Barcode Produk (Unik):"/>
        <TextField fx:id="txtBarcode" promptText="misal: 8991234567890"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Nama Produk:"/>
        <TextField fx:id="txtName" promptText="misal: Biskuit Roma Kelapa 300g"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Kategori:"/>
        <ComboBox fx:id="cmbCategory" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="10">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Harga Beli (Modal):"/>
            <TextField fx:id="txtBuyPrice" promptText="0"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Harga Jual:"/>
            <TextField fx:id="txtSellPrice" promptText="0"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Stok Awal:"/>
            <TextField fx:id="txtStock" promptText="0"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Batas Min Alert:"/>
            <TextField fx:id="txtMinStock" promptText="5"/>
        </VBox>
    </HBox>

    <Label fx:id="lblError" text="" style="-fx-text-fill: #DC2626; -fx-font-weight: bold;" visible="false" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Batal" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="Simpan Produk" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>

</VBox>

