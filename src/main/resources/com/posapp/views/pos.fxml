<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.posapp.controller.PosController"
      spacing="16" stylesheets="@../styles/main.css">

    <!-- Left Column: Search & Cart Table (65%) -->
    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <!-- Barcode Search Bar -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
            <Label text="Scan Barcode / Cari:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtSearch" promptText="Scan barcode atau ketik nama produk [F1]..." onAction="#handleSearchProduct" HBox.hgrow="ALWAYS"/>
            <Button text="Tambah ke Keranjang" onAction="#handleSearchProduct" styleClass="btn-primary"/>
        </HBox>

        <!-- Cart Table -->
        <TableView fx:id="tblCart" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBarcode" text="Barcode" prefWidth="130"/>
                <TableColumn fx:id="colName" text="Nama Produk" prefWidth="250"/>
                <TableColumn fx:id="colPrice" text="Harga Satuan" prefWidth="110"/>
                <TableColumn fx:id="colQty" text="Qty" prefWidth="60"/>
                <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="120"/>
            </columns>
        </TableView>

        <!-- Cart Actions -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="➕ Tambah (+1)" onAction="#handleIncreaseQty" styleClass="btn-secondary"/>
            <Button text="➖ Kurang (-1)" onAction="#handleDecreaseQty" styleClass="btn-secondary"/>
            <Button text="🗑 Hapus Item" onAction="#handleRemoveItem" styleClass="btn-danger"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Batal Transaksi" onAction="#handleClearCart" styleClass="btn-secondary"/>
        </HBox>

        <Label fx:id="lblMessage" text="" style="-fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Right Column: Payment Panel (35%) -->
    <VBox spacing="16" prefWidth="350" styleClass="card">
        <Label text="TOTAL TAGIHAN" styleClass="metric-title"/>
        <Label fx:id="lblGrandTotal" text="Rp 0" styleClass="grand-total-display"/>

        <Separator/>

        <!-- Payment Method Selection -->
        <VBox spacing="8">
            <Label text="Metode Pembayaran:" style="-fx-font-weight: bold;"/>
            <HBox spacing="16">
                <fx:define>
                    <ToggleGroup fx:id="paymentToggleGroup"/>
                </fx:define>
                <RadioButton fx:id="rbCash" text="Tunai (Cash)" toggleGroup="$paymentToggleGroup" selected="true"/>
                <RadioButton fx:id="rbQris" text="QRIS / Digital" toggleGroup="$paymentToggleGroup"/>
            </HBox>
        </VBox>

        <!-- Cash Input & Quick Cash Buttons -->
        <VBox spacing="8">
            <Label text="Uang Tunai Diterima:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtAmountPaid" promptText="Masukkan nominal bayar..."/>

            <FlowPane hgap="8" vgap="8">
                <Button text="Uang Pas" onAction="#handleQuickCash" styleClass="btn-secondary"/>
                <Button text="10.000" onAction="#handleQuickCash" styleClass="btn-secondary"/>
                <Button text="20.000" onAction="#handleQuickCash" styleClass="btn-secondary"/>
                <Button text="50.000" onAction="#handleQuickCash" styleClass="btn-secondary"/>
                <Button text="100.000" onAction="#handleQuickCash" styleClass="btn-secondary"/>
            </FlowPane>
        </VBox>

        <!-- Change Amount Display -->
        <VBox spacing="4" style="-fx-background-color: #F1F5F9; -fx-padding: 10; -fx-background-radius: 6;">
            <Label text="Uang Kembalian:" styleClass="metric-title"/>
            <Label fx:id="lblChange" text="Rp 0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Checkout Button -->
        <Button text="✅ BAYAR &amp; CETAK NOTA [Enter]" onAction="#handleProcessCheckout" maxWidth="Infinity" prefHeight="50" styleClass="btn-success" style="-fx-font-size: 14px;"/>
    </VBox>

</HBox>

