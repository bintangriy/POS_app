<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.posapp.controller.InventoryController"
      spacing="14" stylesheets="@../styles/main.css">

    <Label text="Manajemen Persediaan &amp; Log Mutasi Stok" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- Tab 1: Restock Barang Masuk -->
        <Tab text="📥 Restock (Barang Masuk)">
            <VBox spacing="14" styleClass="card">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="Pencatatan Penerimaan Barang Baru dari Supplier" style="-fx-font-weight: bold;"/>

                <GridPane hgap="12" vgap="12">
                    <Label text="Pilih Produk:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbRestockProduct" prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Jumlah Masuk:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtRestockQty" promptText="Kuantitas unit..." prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Catatan / No. PO:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtRestockRemarks" promptText="Keterangan..." prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Simpan Restock" onAction="#handleProcessRestock" styleClass="btn-success"/>
                    <Label fx:id="lblRestockMsg" text="" style="-fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- Tab 2: Penyesuaian Stok (Opname) -->
        <Tab text="⚖️ Penyesuaian Stok (Opname)">
            <VBox spacing="14" styleClass="card">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="Koreksi Selisih Stok Fisik (Barang Rusak, Hilang, atau Kadaluarsa)" style="-fx-font-weight: bold;"/>

                <GridPane hgap="12" vgap="12">
                    <Label text="Pilih Produk:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbAdjustProduct" prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Stok Fisik Aktual:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtAdjustNewStock" promptText="Jumlah stok nyata..." prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Alasan Koreksi:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtAdjustReason" promptText="misal: 2 botol pecah di gudang..." prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Simpan Penyesuaian" onAction="#handleProcessAdjustment" styleClass="btn-primary"/>
                    <Label fx:id="lblAdjustMsg" text="" style="-fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- Tab 3: Riwayat Mutasi Lengkap -->
        <Tab text="📜 Riwayat Mutasi (Audit Log)">
            <VBox spacing="10" styleClass="card">
                <TableView fx:id="tblMovements" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" text="Waktu" prefWidth="130"/>
                        <TableColumn fx:id="colProduct" text="Nama Produk" prefWidth="220"/>
                        <TableColumn fx:id="colType" text="Tipe Mutasi" prefWidth="130"/>
                        <TableColumn fx:id="colQty" text="Qty" prefWidth="70"/>
                        <TableColumn fx:id="colBefore" text="Sebelum" prefWidth="75"/>
                        <TableColumn fx:id="colAfter" text="Sesudah" prefWidth="75"/>
                        <TableColumn fx:id="colUser" text="Petugas" prefWidth="140"/>
                        <TableColumn fx:id="colRemarks" text="Keterangan" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>

</VBox>

